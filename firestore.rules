rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // Fix: Use email check to bypass get() deployment issue
      return isAuthenticated() && (
        request.auth.token.email == 'y.barberis@enr-courtage.fr' || 
        request.auth.token.email == 'contact@nelsonpv.fr'
      ); 
    }
    
    function canViewAllProjects() {
      return isAuthenticated(); // Allow view all for now to ensure sync
    }
    
    // RÈGLES TEMPORAIRES DE DEBUG - Permettre lecture à tous authentifiés
    // TODO: Revenir aux règles strictes une fois le problème identifié
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow users to update their own profile
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Only admins can create new users
      allow create, delete: if isAdmin();
    }
    
    // Contacts collection
    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated(); // COLLABORATIVE MODE
    }
    
    // Comments collection - anyone can read, only author can update/delete
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
                                (isAdmin() || resource.data.userId == request.auth.uid);
    }
    
    // Notifications collection - users can only read their own notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                       (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated(); // COLLABORATIVE MODE
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Activities collection
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Config collection - shared application configuration
    match /config/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Tous peuvent modifier pour sync temps réel
    }
    // Daily KPI - Monday tables ( Collaborative )
    match /monday_tables/{tableId} {
      allow read, write: if isAuthenticated();
      
      match /rows/{rowId} {
        allow read, write: if isAuthenticated();
      }
    }

  }
}
