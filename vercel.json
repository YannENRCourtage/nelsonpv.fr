{
    "rewrites": [
        {
            "source": "/sdis-proxy/17/(.*)",
            "destination": "https://api.deci.sdis17.fr/$1"
        },
        {
            "source": "/sdis-proxy/84/(.*)",
            "destination": "https://api.deci.sdis84.fr/$1"
        },
        {
            "source": "/sdis-proxy/81/(.*)",
            "destination": "https://api.deci.sdis81.fr/$1"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(self)"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                }
            ]
        }
    ],
    "functions": {
        "api/pvgis.js": {
            "maxDuration": 60
        },
        "api/proxies/[[...slug]].js": {
            "maxDuration": 60
        },
        "api/admin/change-password.js": {
            "maxDuration": 30
        }
    }
}